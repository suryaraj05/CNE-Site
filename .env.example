# Site
# CNE_SITE_URL=https://cargonortheast.com
# CNE_ADMIN_PASSWORD=cne-admin
# CNE_NOINDEX=1

# Neon PostgreSQL — Custom SEO Dashboard (written by `neon deploy` into .env.local)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
NEON_BRANCH=production
# NEON_BRANCH_ID=
# Or discrete:
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASS=
# DB_SSLMODE=require
